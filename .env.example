# Server port (Railway injects PORT automatically)
PORT=3000

# Enable production security defaults (HTTPS enforcement & Secure cookies)
NODE_ENV=production

# Strong random secret (>= 32 chars). Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Trust the single Railway / reverse-proxy TLS hop for X-Forwarded-Proto & client IP
TRUST_PROXY=1

# Optional persistent paths (Railway sets RAILWAY_VOLUME_MOUNT_PATH automatically)
# DATA_DIR=/data
# DB_PATH=/data/spendwise.db
